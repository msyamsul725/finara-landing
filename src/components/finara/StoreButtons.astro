---
import { storeLinks } from "../../config/site";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["store-buttons", className]}>
  <a
    class="store-badge"
    href={storeLinks.appStore}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Download Finara di App Store"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path
        fill="currentColor"
        d="M17.1 12.6c0-2.1 1.7-3.2 1.8-3.3-1-1.5-2.6-1.7-3.2-1.7-1.4-.1-2.8.8-3.5.8-.7 0-1.9-.8-3.1-.8-1.6 0-3.1.9-3.9 2.3-1.7 2.9-.4 7.2 1.2 9.5.8 1.1 1.7 2.3 2.9 2.2 1.2 0 1.6-.7 3.1-.7 1.4 0 1.8.7 3.1.7 1.3 0 2.1-1.1 2.9-2.2.9-1.3 1.3-2.6 1.3-2.7-.1 0-2.6-1-2.6-4.1ZM14.8 6.1c.7-.9 1.2-2.1 1.1-3.3-1 .1-2.2.7-3 1.5-.7.8-1.3 2-1.1 3.2 1.1.1 2.2-.6 3-1.4Z"
      ></path></svg
    >
    <span><small>Download on the</small><b>App Store</b></span>
  </a>
  <a
    class="store-badge"
    href={storeLinks.googlePlay}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Download Finara di Google Play"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path fill="#51CBF2" d="M3 2 14 12 3 22Z"></path><path fill="#63D580" d="m3 2 14 8-3 2Z"
      ></path><path fill="#FFD35A" d="m17 10 4 2-4 2-3-2Z"></path><path fill="#FF7777" d="m3 22 14-8-3-2Z"
      ></path></svg
    >
    <span><small>GET IT ON</small><b>Google Play</b></span>
  </a>
</div>
