---
import StoreButtons from "./StoreButtons.astro";
import HeroMockups from "./HeroMockups.astro";
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <div class="eyebrow">Keuangan bersama orang terdekat</div>
      <h1>Atur Bersama,<br /><span>Tumbuh Bersama.</span></h1>
      <p>
        Dari pengeluaran sehari-hari hingga keuangan keluarga. Catat, pahami, dan kelola uangmu
        bersama orang yang berarti.
      </p>
      <StoreButtons />
      <div class="hero-note">
        <svg aria-hidden="true"><use href="#check"></use></svg>
        Tersedia di App Store dan Google Play
      </div>
    </div>
    <HeroMockups />
  </div>
</section>
