---
import FinaraLayout from "../layouts/FinaraLayout.astro";
import Header from "../components/finara/Header.astro";
import Hero from "../components/finara/Hero.astro";
import BenefitsStrip from "../components/finara/BenefitsStrip.astro";
import Features from "../components/finara/Features.astro";
import ProductStory from "../components/finara/ProductStory.astro";
import Together from "../components/finara/Together.astro";
import GettingStarted from "../components/finara/GettingStarted.astro";
import Faq from "../components/finara/Faq.astro";
import DownloadCta from "../components/finara/DownloadCta.astro";
import Footer from "../components/finara/Footer.astro";
---

<FinaraLayout>
  <Header slot="header" />
  <Hero />
  <BenefitsStrip />
  <Features />
  <ProductStory />
  <Together />
  <GettingStarted />
  <Faq />
  <DownloadCta />
  <Footer slot="footer" />
</FinaraLayout>
